{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023",
      "dom"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "contentMappers": [
    {
      "package": "interstage",
      "extensions": [
        ".wgsl"
      ],
      "options": {
        "validate": true
      }
    }
  ],
  "include": [
    "src"
  ]
}
