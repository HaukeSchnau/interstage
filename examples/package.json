{
  "name": "interstage-examples",
  "private": true,
  "type": "module",
  "scripts": {
    "contract": "pnpm --dir .. run build && tsc -p tsconfig.contract.json --runExternalCode",
    "dev": "pnpm run contract && vite",
    "build": "pnpm run contract && vite build",
    "typecheck": "pnpm --dir .. run build && tsc --noEmit --runExternalCode && tsc -p tsconfig.scripts.json --noEmit --runExternalCode",
    "check": "node scripts/check.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/recursive": "^5.2.8",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "typegpu": "0.12.8",
    "typescript-js": "npm:typescript@6.0.3",
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@types/node": "^26.1.1",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "interstage": "workspace:*",
    "playwright-core": "^1.64.1",
    "typescript": "7.1.0-beta",
    "unplugin-typegpu": "0.12.6",
    "vite": "^8.3.5",
    "webgpu": "^0.6.2"
  }
}
