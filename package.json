{
  "name": "interstage",
  "version": "0.1.0",
  "description": "Import WGSL into TypeScript as typed TypeGPU modules. A TypeScript 7.1 content mapper and a Vite plugin.",
  "keywords": [
    "content-mapper",
    "shader",
    "typegpu",
    "typescript",
    "vite-plugin",
    "webgpu",
    "wgsl"
  ],
  "homepage": "https://interstage.schnau.dev",
  "license": "MIT",
  "author": "Hauke Schnau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaukeSchnau/interstage.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsrs -p tsconfig.build.json",
    "check": "pnpm build && vp check",
    "test": "vp test run",
    "prepare": "tsrs -p tsconfig.build.json",
    "prepack": "tsrs -p tsconfig.build.json"
  },
  "dependencies": {
    "ts-content-mapper": "^0.1.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "@schnau/tsconfig": "^0.1.1",
    "@types/node": "^26.1.1",
    "interstage": "link:.",
    "tsrs": "catalog:",
    "typegpu": "0.12.8",
    "typescript": "7.1.0-beta",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "webgpu": "^0.6.2"
  },
  "peerDependencies": {
    "typegpu": "^0.12.8",
    "vite": ">=7",
    "webgpu": ">=0.3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "webgpu": {
      "optional": true
    }
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper.js"
      ]
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.9.0"
}
