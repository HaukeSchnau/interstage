{
  "name": "interstage",
  "version": "0.1.0",
  "description": "Import WGSL into TypeScript as typed TypeGPU modules. A TypeScript 7.1 content mapper and a Vite plugin.",
  "license": "MIT",
  "author": "Hauke Schnau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaukeSchnau/interstage.git"
  },
  "keywords": [
    "wgsl",
    "webgpu",
    "typegpu",
    "typescript",
    "content-mapper",
    "vite-plugin",
    "shader"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper.js"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --runExternalCode",
    "test": "pnpm run build && node --import ./src/register.ts --test 'test/*.test.ts'",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "ts-content-mapper": "^0.1.0"
  },
  "peerDependencies": {
    "typegpu": "^0.12.8",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typegpu": "0.12.8",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.5",
    "interstage": "link:.",
    "webgpu": "^0.6.2"
  }
}
